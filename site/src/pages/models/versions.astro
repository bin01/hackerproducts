---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import LoveCharts from "../../components/LoveCharts.astro";
import VersionTable from "../../components/VersionTable.astro";
import catalog from "../../data/catalog.json";

const families = (catalog as any).version_families;
---
<Base title="Which AI models are loved" active="models" image="/og/versions.png" imageAlt="Which AI models are loved: love score for the releases out now" description="Which AI model releases Hacker News commenters love, compared with others from the same generation.">
  <h1 style="font-size:18px">Which AI models are loved?</h1>
  <LoveCharts />
  <p class="small"><a href="/models/compare/">Compare all models: best for each job, head to head, who's switching →</a></p>
  <section class="cmp-sec" id="tables">
    <h2>Every version, all-time numbers</h2>
    <p class="small muted" style="margin-top:0">These count all comments that named a version, whenever they were written, so they can differ from the charts above.</p>
    {families.map((f: any) => (
      <details class="vt-tier">
        <summary class="vt-group"><Icon p={f} />{f.name} <span class="muted small">{f.lines.length === 1 ? `${f.lines[0].versions.length} versions` : `${f.lines.length} lines`}</span></summary>
        {f.lines.map((l: any) => (
          <>
            {!(f.lines.length === 1 && l.slug === f.slug) && <h3 class="vt-group"><a href={`/p/${l.slug}/`}>{l.slug === f.slug ? `${f.name}, no tier named` : l.name}</a></h3>}
            <VersionTable name={l.name} versions={l.versions} href={`/p/${l.slug}/`} legend={false} />
          </>
        ))}
      </details>
    ))}
    <div class="legend vlegend"><span><i class="s-recommend" />recommend</span><span><i class="s-neutral" />uses or compares</span><span><i class="s-warn" />warns</span></div>
  </section>
</Base>
