---
import Base from "../layouts/Base.astro";
import { categories, listed } from "../lib/data";
---
<Base title="Categories" active="categories">
  <h1 style="font-size:18px">Categories</h1>
  <ol class="list">
    {categories.map((c) => {
      const top = listed.filter((p) => p.category === c.slug).slice(0, 4);
      return (
        <li class="row" data-nav style="grid-template-columns: 1fr auto">
          <div><a class="name" href={`/c/${c.slug}/`}>{c.name}</a> <span class="meta">· {c.count} products</span></div>
          <span />
          <div class="why muted" style="grid-column: 1 / 3">{top.map((p) => p.name).join(", ")}</div>
        </li>
      );
    })}
  </ol>
</Base>
