---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { categories, listed, months, monthLabel, AI_MODELS } from "../lib/data";

const order = [...categories.filter((c) => c.slug === AI_MODELS), ...categories.filter((c) => c.slug !== AI_MODELS && c.slug !== "other"), ...categories.filter((c) => c.slug === "other")];
const rows = order.map((c) => {
  const items = listed.filter((p: any) => p.category === c.slug && !p.family);
  const sentiment = { recommend: 0, neutral: 0, compare: 0, warn: 0 };
  items.forEach((p) => (Object.keys(sentiment) as (keyof typeof sentiment)[]).forEach((k) => { sentiment[k] += p.sentiment[k]; }));
  const total = Object.values(sentiment).reduce((a, b) => a + b, 0) || 1;
  const spark = months.map((_, j) => items.reduce((a, p) => a + (p.spark[j] || 0), 0));
  return { ...c, top: items.slice(0, 4), sentiment, total, spark, peak: Math.max(1, ...spark) };
});
---
<Base title="Categories" active="categories" description="Software Hacker News commenters recommend, by category.">
  <h1 style="font-size:18px">Categories</h1>
  <p class="lede">What HN commenters recommend in each area, with its most recommended products, how often it comes up each month, and how the comments lean.</p>
  <ol class="list">
    {rows.map((c) => (
      <li class="row cat-row" data-nav>
        <div><a class="name" href={`/c/${c.slug}/`}>{c.name}</a> <span class="meta">· {c.count} {c.slug === AI_MODELS ? "families" : "products"}</span></div>
        <div class="viz">
          <svg class="spark" width="60" height="16" viewBox="0 0 60 16" aria-label={`Recommendations per month, ${monthLabel(months[0])} to ${monthLabel(months[months.length - 1])}`}>
            {c.spark.map((v, j) => <rect x={j * 5} y={16 - (14 * v) / c.peak - 1} width="4" height={(14 * v) / c.peak + 1} opacity={v ? 1 : 0.25} />)}
          </svg>
          <span class="bar" title={`${c.sentiment.recommend} recommend · ${c.sentiment.neutral} neutral · ${c.sentiment.compare} compare · ${c.sentiment.warn} warn`}>
            {(["recommend", "neutral", "compare", "warn"] as const).map((k) => <span class={`s-${k}`} style={`width:${(100 * c.sentiment[k]) / c.total}%`} />)}
          </span>
        </div>
        <div class="cat-top">
          {c.top.map((p) => <a href={`/p/${p.slug}/`}><Icon p={p} />{p.name}</a>)}
        </div>
      </li>
    ))}
  </ol>
</Base>
