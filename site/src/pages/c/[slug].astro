---
import Base from "../../layouts/Base.astro";
import ProductList from "../../components/ProductList.astro";
import ListTools from "../../components/ListTools.astro";
import { categories, listed } from "../../lib/data";

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const items = listed.filter((p: any) => p.category === c.slug && !p.family);
---
<Base title={c.name} active={c.slug === "ai-models" ? "models" : "categories"} description={`What Hacker News commenters recommend for ${c.name.toLowerCase()}.`}>
  <div class="chips">
    {categories.map((o) => <a class:list={["chip", { on: o.slug === c.slug }]} href={`/c/${o.slug}/`}>{o.name}</a>)}
  </div>
  <h1 style="font-size:18px">{c.name}</h1>
  <p class="lede">What HN commenters recommend, ranked by distinct recommenders. Under each: what people praise most and the most common caveat, or the strongest quote where there is no summary yet.</p>
  {c.slug === "ai-models" && <>
    <p class="lede">One row per model family, counting each person once across its tiers and versions.</p>
    <a class="vteaser" href="/models/compare/"><b>Compare all models</b> <span class="muted">best for each job, head to head, who's switching →</span></a>
    <a class="vteaser" href="/models/versions/"><b>Which models are loved</b> <span class="muted">ranked within each generation, love map, version by version →</span></a>
  </>}
  <ListTools title={c.name} items={items} json={`/export/category-${c.slug}.json`} />
  <ProductList items={items} showCategory={false} />
</Base>
