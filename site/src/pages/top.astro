---
import Base from "../layouts/Base.astro";
import ProductList from "../components/ProductList.astro";
import ListTools from "../components/ListTools.astro";
import { listed, stats } from "../lib/data";
---
<Base title="Top" active="top">
  <h1 style="font-size:18px">Top</h1>
  <p class="lede">Products recommended by at least 3 HN commenters ({stats.window}), ranked by distinct recommenders: one vote per HN user, ties broken by recency. Warnings are shown beside each product, and comments by a product's own makers don't count.</p>
  <ListTools title="Top" items={listed} json="/export/products.json" />
  <ProductList items={listed} />
</Base>
