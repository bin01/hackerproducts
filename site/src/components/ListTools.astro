---
import type { Summary } from "../lib/data";
import { toMarkdown } from "../lib/data";

interface Props { title: string; items: Summary[]; json: string }
const { title, items, json } = Astro.props;
// Links stay relative here and get the page's own origin when copied, so no host is baked into the build.
const md = toMarkdown(title, items.slice(0, 50), "");
---
<div class="btns">
  <button class="btn" data-copy={md} type="button">Copy as Markdown</button>
  <a class="btn" href={json}>JSON</a>
</div>
<script is:inline>
  document.querySelectorAll("[data-copy]").forEach((b) => b.addEventListener("click", async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy.replaceAll("](/", `](${location.origin}/`)); b.textContent = "Copied"; }
    catch (e) { b.textContent = "Copy failed"; }
    setTimeout(() => (b.textContent = "Copy as Markdown"), 1500);
  }));
</script>
