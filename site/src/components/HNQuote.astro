---
import { fmtDate } from "../lib/data";

interface Props { q: any }
const { q } = Astro.props;
const label = { recommend: "recommends", neutral: "uses it", compare: "compares", warn: "warns" }[q.stance as string];
const ctx = (q.context ? 100 : 0) + (q.quote || q.excerpt || "").length;
---
<div class="hq" id={`q${q.id}`} data-stance={q.stance} data-date={q.date} data-ctx={ctx}>
  <div class="hq-hd">
    <a class="hq-by" href={`https://news.ycombinator.com/user?id=${q.by}`}>{q.by}</a>
    <a href={q.url} title="Open the comment on Hacker News">{fmtDate(q.date)}</a>
    <span class={`st-${q.stance}`}>{label}</span>
  </div>
  <p>{q.quote ? <>“{q.quote}”</> : q.excerpt}</p>
  {(q.context || q.switched_from || q.story) && (
    <div class="hq-ft">
      {q.context && <span>{q.context}</span>}
      {q.switched_from && <span>switched from {q.switched_from}</span>}
      {q.story && <a href={q.url}>on “{q.story.length > 54 ? q.story.slice(0, 52) + "…" : q.story}”</a>}
    </div>
  )}
</div>
