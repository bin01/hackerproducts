---
interface Props { p: { slug: string; name: string; icon?: boolean }; size?: number }
const { p, size = 16 } = Astro.props;
---
{p.icon
  ? <img class="ico" src={`/icons/${p.slug}.ico`} alt="" width={size} height={size} loading="lazy" decoding="async" />
  : <span class="ico mono-ico" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.62)}px`} aria-hidden="true">{p.name.slice(0, 1).toUpperCase()}</span>}
