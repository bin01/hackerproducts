---
import { fmtDate } from "../lib/data";

interface Props { q: any }
const { q } = Astro.props;
const label = { recommend: "recommends", neutral: "uses", compare: "compares", warn: "warns" }[q.stance as string];
---
<div class="q" id={`q${q.id}`}>
  <div class="hd">
    <a href={`https://news.ycombinator.com/user?id=${q.by}`}>{q.by}</a> · <a href={q.url} title="Open the comment on Hacker News">{fmtDate(q.date)}</a>
    · <span class={`st st-${q.stance}`}>{label}</span>
    {q.story && <> · on <a href={q.url}>{q.story.length > 60 ? q.story.slice(0, 58) + "…" : q.story}</a></>}
  </div>
  <blockquote>{q.quote ? <>“{q.quote}”</> : q.excerpt}</blockquote>
  {(q.context || q.switched_from) && (
    <div class="ctx">
      {q.context}{q.context && q.switched_from && " · "}{q.switched_from && <>switched from {q.switched_from}</>}
    </div>
  )}
</div>
